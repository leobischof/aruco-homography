<?xml version="1.0" encoding="utf-8"?>
<!--
  KEINE Berechtigung fuer das Netz. Das ist die Zusage dieses Vorhabens und keine
  Sparsamkeit: die Messung laeuft im Geraet, das PDF entsteht im Geraet, und ein
  Foto einer Werkstatt hat auf keinem fremden Rechner etwas zu suchen. Ohne
  android.permission.INTERNET kann die App gar nicht senden - das ist eine
  Zusicherung des Systems und nicht eine des Programmierers.

  KEINE Berechtigung fuer den Speicher: gelesen wird ueber ACTION_OPEN_DOCUMENT,
  geschrieben ueber ACTION_CREATE_DOCUMENT - beide geben dem Nutzer die Wahl und
  der App nur die eine Datei.

  Die Kamera braucht die App SEIT DEM LIVE-BILD. Bis dahin stand hier, dass sie
  ohne auskommt, und das stimmte: ACTION_IMAGE_CAPTURE laesst die Kamera-App des
  Systems fotografieren, und zurueck kommt eine Datei. Ein Sucher, der die Marker
  schon im laufenden Bild findet, kann das nicht - er braucht den Strom selbst,
  und getUserMedia laeuft im eigenen Prozess.

  Der Preis steht in MainActivity: eine DEKLARIERTE, aber nicht erteilte
  CAMERA-Berechtigung laesst ACTION_IMAGE_CAPTURE mit einer SecurityException
  scheitern (so dokumentiert ab Android 6). Der Weg ueber die Kamera-App muss
  seither also ebenfalls erst fragen, obwohl er die Berechtigung gar nicht
  benutzt.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />

    <!--
      required="false": ein Geraet ohne Kamera soll die App trotzdem installieren
      koennen. Sie ist dort nicht nutzlos - ein Foto laesst sich auch waehlen,
      und der Rest der Rechnung braucht keine Linse. Ohne diese Zeile leitet
      Android aus der Berechtigung ein hartes <uses-feature> ab und blendet die
      App auf solchen Geraeten aus.
    -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!--
      Ab Android 11 sieht eine App fremde Anwendungen nur, wenn sie danach fragt.
      Ohne diesen Block liefert queryIntentActivities fuer die Kamera eine leere
      Liste, und der Knopf "Foto aufnehmen" waere ohne Grund abgeblendet.
    -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Aruco">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|smallestScreenSize|density"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Fuer zwei Wege nach draussen: das Foto, das die Kamera-App in unseren
          Cache schreibt, und das PDF, das per "Teilen" weitergereicht wird. Ohne
          einen FileProvider muesste dafuer eine file://-URI herausgegeben werden,
          und die verbietet Android seit Nougat mit einer FileUriExposedException.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
